{
  "name": "Doplatky liekov",
  "short_name": "Doplatky",
  "description": "Porovnanie doplatkov za lieky, Moje lieky, zmeny a výpadky.",
  "lang": "sk",
  "id": "/",
  "start_url": "/?zdroj=aplikacia",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0b4fb3",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Hľadať liek",
      "short_name": "Hľadať",
      "url": "/?akcia=hladat",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Odfotiť krabičku alebo recept",
      "short_name": "Odfotiť",
      "url": "/?akcia=foto",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Moje lieky",
      "url": "/moje-lieky/",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Odfotiť bloček",
      "short_name": "Bloček",
      "url": "/ochranny-limit/?akcia=blocek#tracker",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/zdielane/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "foto",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
